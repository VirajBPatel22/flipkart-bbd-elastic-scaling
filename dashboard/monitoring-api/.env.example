# Local server port

PORT=5001



# Comma-separated list of origins allowed to call this API in development

CORS_ORIGIN=http://localhost:5174



# AWS integration (added in a later phase):

# This API will run on an EC2 instance with a least-privilege IAM role

# (read-only access to EC2, Auto Scaling, Elastic Load Balancing and

# CloudWatch describe/list actions). It must NOT use long-lived AWS access

# keys. Never put AWS credentials in this file or in frontend code.

# AWS_REGION=

# ASG_NAME=


# AWS deployment: instance role supplies credentials
ENVIRONMENT=LOCAL_DOCKER
AWS_REGION=ap-south-1
ASG_NAME=
TARGET_GROUP_ARN=
LOAD_BALANCER_ARN=

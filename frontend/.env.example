# Vite only exposes variables prefixed with VITE_ to the browser bundle.
# Do NOT put secrets, AWS keys, or Supabase service-role keys here.

# Base URL of the backend API (will later point at the AWS Load Balancer DNS name)
VITE_API_BASE_URL=http://localhost:5000

# URL of the monitoring dashboard frontend, used for the "Monitoring Dashboard" link.
VITE_DASHBOARD_URL=http://localhost:5174

# Local server port (EC2 deployments will override this via the environment)

PORT=5000



# Comma-separated list of origins allowed to call this API in development

CORS_ORIGIN=http://localhost:5173



# --- Supabase Postgres Connection String ------------------------------------

# This backend connects DIRECTLY to Postgres via the `pg` driver.

#

# IMPORTANT (IPv4 vs IPv6):

# Supabase's "Direct connection" (db.<ref>.supabase.co) only publishes IPv6

# (AAAA) DNS records on free tiers. On most local Windows/ISP networks that lack

# IPv6, this causes "getaddrinfo ENOTFOUND db.<ref>.supabase.co".

#

# To avoid this, use the Supavisor "Connection pooler" string (Session mode, port 5432):

#   Supabase dashboard -> Project Settings -> Database -> Connection string

#   -> "URI" tab -> select "Session pooler" (port 5432)

#

# Format:

#   postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres



# Older setups may have this same connection string stored as SUPABASE_URL

# instead — the backend accepts either variable name (DATABASE_URL wins if

# both are set). A Supabase REST "anon"/"publishable" key is NOT needed by

# this backend anymore, since it talks to Postgres directly.



# --- Load Testing & Controlled Compute Endpoint (POST /api/demo/compute) ----

# Set to 'false' to completely disable the compute endpoint

ENABLE_DEMO_COMPUTE=true

# Secret token required in headers (x-load-test-token or Bearer authorization)

# Generate a private value with: openssl rand -hex 32

LOAD_TEST_TOKEN=

# Maximum concurrent CPU worker jobs before returning HTTP 429

MAX_CONCURRENT_COMPUTE_JOBS=2



# --- Backend Server Identity (GET /api/instance) -----------------------------

# Optional manual override for local testing; when omitted, uses IMDSv2 on EC2

# or falls back to local-<hostname>.

# INSTANCE_ID=


# TLS verification defaults to true. AWS refuses false.
DB_SSL_REJECT_UNAUTHORIZED=true
# Optional provider CA, base64 encoded on one line.
DATABASE_CA_BASE64=
